# ===========================================================================
#  BLICKWINKEL Code-App – Umgebungsvariablen
#  Kopiere diese Datei nach ".env.local" (lokal) bzw. trage die Werte in den
#  Vercel-Projekteinstellungen ein. NIEMALS echte Werte committen!
# ===========================================================================

# --- Anmeldung ---------------------------------------------------------------
# Gemeinsames Passwort für alle Mitarbeiter.
APP_PASSWORD="bitte-ein-sicheres-passwort"

# Zufälliger Schlüssel zum Signieren der Login-Cookies (min. 32 Zeichen).
# Erzeugen z.B. mit:  openssl rand -base64 32
SESSION_SECRET="bitte-langen-zufaelligen-string-eintragen"

# Kommagetrennte Liste der 4 Mitarbeiter (Namen erscheinen in der Auswahl
# und in der History).
EMPLOYEES="Anna,Bernd,Clara,David"

# --- Datenbank (Postgres) ----------------------------------------------------
# Wird beim Anlegen von Vercel Postgres / Neon automatisch gesetzt.
POSTGRES_URL="postgres://user:pass@host/db?sslmode=require"

# --- Google Sheet ------------------------------------------------------------
# ID des Sheets (aus der URL zwischen /d/ und /edit).
GOOGLE_SHEET_ID="1NtKoTGyMI77qyID2GBDCCuvpcsBGIjWx30eQ5ARtbOQ"

# Service-Account-Zugangsdaten. Zwei Varianten – EINE genügt:
#
# Variante A: die komplette JSON-Datei als eine Zeile.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", ...}'
#
# Variante B: nur die zwei wichtigen Felder einzeln.
# GOOGLE_CLIENT_EMAIL="code-app@dein-projekt.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Automatischer Sync (Vercel Cron) ---------------------------------------
# Frei wählbares Geheimnis; schützt den Cron-Endpunkt.
CRON_SECRET="beliebiges-geheimnis"

# --- Optional (Standardwerte sind sinnvoll) ---------------------------------
# GOOGLE_CODES_TAB="All Codes Sheet"
# GOOGLE_HISTORY_TAB="Code App History"
# GOOGLE_CODES_FIRST_ROW="3"
# RESERVATION_TIMEOUT_MIN="15"
# LOW_STOCK_THRESHOLD="3"
